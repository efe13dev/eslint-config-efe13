{
  "name": "lint-config",
  "version": "1.5.0",
  "type": "module",
  "bin": {
    "lint-config": "bin/index.js"
  },
  "files": [
    "bin/",
    "src/",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "eslint",
    "prettier",
    "biome",
    "oxlint",
    "oxfmt",
    "nextjs",
    "vite",
    "backend",
    "backend-ts",
    "node",
    "typescript",
    "config",
    "cli"
  ],
  "author": "efe13dev",
  "license": "ISC",
  "description": "Configuración de ESLint + Prettier, Biome u oxlint + Oxfmt inspirada en Goncy con un CLI para proyectos Next.js, Vite y backend-ts (Node/TypeScript).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/efe13dev/lint-config.git"
  },
  "bugs": {
    "url": "https://github.com/efe13dev/lint-config/issues"
  },
  "homepage": "https://github.com/efe13dev/lint-config#readme",
  "dependencies": {
    "chalk": "^5.6.2",
    "inquirer": "^9.3.8",
    "ora": "^6.3.1"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "vitest": "^4.1.11"
  }
}
